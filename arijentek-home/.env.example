# Optional settings. Copy this file to .env, fill in, then restart the dev
# server. Any service that accepts a JSON POST works (Formspree, Basin, or a
# small serverless function).

# Contact form (only in the "Form" layout of the closing section). Without it,
# the form opens the visitor's email app instead.
VITE_CONTACT_ENDPOINT=

# Newsletter signup in the footer. Without it, the signup is not shown.
VITE_NEWSLETTER_ENDPOINT=

# The Design menu (bottom-left, D key) is a review tool for comparing layouts.
# It is always on with `npm run dev`; set this to true for a build that shows
# it to reviewers. Leave it empty for the public site: no menu, defaults only.
VITE_DESIGN_REVIEW=
